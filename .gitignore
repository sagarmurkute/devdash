# ==========================================
# DevSlash — Git Ignore Configuration
# ==========================================

# Next.js Build Output & Cache
.next/
out/
build/
dist/
.turbo/

# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Testing & Coverage
coverage/
.nyc_output/

# Vercel Deployment
.vercel

# TypeScript & Linter Cache
*.tsbuildinfo
next-env.d.ts
.eslintcache
.prettiercache

# Debug & Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor Specific
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Electron & Desktop Build Artifacts
apps/desktop/dist/
apps/desktop/out/
*.dmg
*.exe
*.AppImage
